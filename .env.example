# Copie para .env e exporte as variáveis (o projeto lê o ambiente, não o arquivo).
# Em desenvolvimento NENHUMA variável é obrigatória.

DJANGO_DEBUG=True
# Obrigatória quando DJANGO_DEBUG=False. Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meusite.com.br
# DJANGO_HTTPS=True

# Banco de dados (padrão: SQLite). Para PostgreSQL instale: pip install "psycopg[binary]"
